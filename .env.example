# ==============================================================================
# AeroLink Environment Variables
# Copy this file to .env and replace placeholder values with your Supabase keys
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (safe for client-side use)
# NEVER put your service_role or secret key here!
VITE_SUPABASE_KEY=your-supabase-anon-publishable-key

# Optional: Force Demo / Mock Mode with local storage (true / false)
# When true, the application runs entirely offline without contacting Supabase
VITE_USE_MOCK=false
